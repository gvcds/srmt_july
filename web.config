<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    
    <!-- 1. Indica ao IIS que o server.js será executado pelo IISNode -->
    <handlers>
      <add name="iisnode" path="server.js" verb="*" modules="iisnode" />
    </handlers>
    
    <!-- 2. Regras de Redirecionamento (URL Rewrite) -->
    <rewrite>
      <rules>
        <!-- Impede o acesso direto a rotas de debug -->
        <rule name="NodeInspector" patternSyntax="ECMAScript" stopProcessing="true">
          <match url="^server.js\/debug[\/]?" />
        </rule>
        
        <!-- Redireciona TUDO para o Next.js (server.js) gerenciar, exceto o próprio server.js e arquivos físicos -->
        <rule name="NextJSRouting">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
          </conditions>
          <action type="Rewrite" url="server.js" />
        </rule>
      </rules>
    </rewrite>

    <!-- 3. Configurações do IISNode -->
    <!-- nodeProcessCommandLine garante que o IIS ache o Node.js. Altere se o seu Node estiver em outro local -->
    <iisnode 
        node_env="production"
        nodeProcessCommandLine="C:\Program Files\nodejs\node.exe"
        loggingEnabled="false"
        devErrorsEnabled="false"
        watchedFiles="web.config;server.js"
    />

    <!-- 4. Permite que o Next.js mostre suas próprias páginas de erro (ex: 404 ou 500 customizadas) -->
    <httpErrors existingResponse="PassThrough" />

    <!-- 5. Segurança: Oculta pastas internas e código fonte do projeto do acesso público -->
    <security>
      <requestFiltering>
        <hiddenSegments>
          <add segment="node_modules" />
          <add segment=".next" />
        </hiddenSegments>
      </requestFiltering>
    </security>
    
  </system.webServer>
</configuration>